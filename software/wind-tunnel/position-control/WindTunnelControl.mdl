<?xml version="1.0" encoding="utf-8"?>
<ModelInformation Version="1.0">
  <Model>
    <P Name="ModelUUID">8c7b70b8-21f9-4fa2-b762-a503e4de1dea</P>
    <P Name="CloseFcn">%% Try to close the GUI (the user might have already closed it)
try

    close(simulinkStaticGUI)
end</P>
    <P Name="InitFcn">cd(fileparts(which(bdroot)));
initWindTunnelControl;

%% Try to edit the GUI (the user may have already closed it)
try

    %% Update Start Button
    set(sl_synch_handles.startButton,&apos;Backgroundcolor&apos;,[0.0,1.0,0.0]);
    set(sl_synch_handles.startButton,&apos;Enable&apos;,&apos;on&apos;);
end</P>
    <P Name="StartFcn">%% Try to edit the GUI (the user may have already closed it)
try

    %% Update Start Button
    set(sl_synch_handles.startButton,&apos;Backgroundcolor&apos;,[0.8,0.8,0.8]);
    set(sl_synch_handles.startButton,&apos;Enable&apos;,&apos;off&apos;);

    %% Update Compile Button
    set(sl_synch_handles.compileButton,&apos;Backgroundcolor&apos;,[0.8,0.8,0.8]);
    set(sl_synch_handles.compileButton,&apos;Enable&apos;,&apos;off&apos;);

    %% Update Exit Button
    set(sl_synch_handles.exitButton,&apos;Backgroundcolor&apos;,[0.8,0.8,0.8]);
    set(sl_synch_handles.exitButton,&apos;Enable&apos;,&apos;off&apos;);
end</P>
    <P Name="StopFcn">cd(fileparts(which(bdroot)));
stopWindTunnelControl;

%% Try to edit the GUI (the user may have already closed it)
try

    %% Update Start Button
    if get(sl_synch_handles.checkbox_recompile, &apos;Value&apos;)  
        set(sl_synch_handles.startButton,&apos;Backgroundcolor&apos;,[0.0,1.0,0.0]);
        set(sl_synch_handles.startButton,&apos;Enable&apos;,&apos;on&apos;);
    end

    %% Update Compile Button
    set(sl_synch_handles.compileButton,&apos;Backgroundcolor&apos;,[1.0,0.6,0.0]);
    set(sl_synch_handles.compileButton,&apos;Enable&apos;,&apos;on&apos;);

    %% Update Exit Button
    set(sl_synch_handles.exitButton,&apos;Backgroundcolor&apos;,[0.0,1.0,1.0]);
    set(sl_synch_handles.exitButton,&apos;Enable&apos;,&apos;on&apos;);
end</P>
    <P Name="LastSavedArchitecture">glnxa64</P>
