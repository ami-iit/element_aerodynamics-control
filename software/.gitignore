# OS X Finder files
.DS_Store

## Matlab: ------------------------------------------
##
## Remove autosaves generated by the Matlab editor
## We have git for backups!
##---------------------------------------------------

# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Simulink Code Generation
slprj/
*.slxc

# Matlab binary .mat files
*.mat
!*aeroFrameTransforms.mat
!*outputParameters.mat
!*dataset*.mat

# Matlab figures
*.fig
!aerodynamic-flight-controllers/controlAndDataGui/*.fig
!wind-tunnel/position-control/src/static-gui/*.fig

# Simulink autosave
*.autosave

# Build directory
build/

## Sublime Text: ------------------------------------
##
## Ignore projects and workspaces.
## url: https://www.sublimetext.com
##---------------------------------------------------
*.sublime-project
*.sublime-workspace

# GIFs
*.gif

# PNGs
*.png

# EPSs
*.eps

# SVGs
*.svg

# MP4s
*.mp4

# Pycache
*.pyc
