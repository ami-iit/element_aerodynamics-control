.DS_Store

## Matlab: ------------------------------------------
##
## Remove autosaves generated by the Matlab editor
## We have git for backups!
##---------------------------------------------------

# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Simulink Code Generation
slprj/
*.slxc

# Matlab binary .mat files
*.mat

# Matlab figures
*.fig
!/flying-controllers/momentum-based-flying/src/controlGui/ironcubControlGui.fig
!/flying-controllers/momentum-based-flying/src/visualGui/flightDataGui.fig

# Simulink autosave
*.autosave

# Build directory
build/

