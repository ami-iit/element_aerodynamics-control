  state {
    id			    448
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    447
    treeNode		    [447 0 0 0]
    superState		    SUBCHART
    subviewer		    447
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function wrenches_vector = compute_jet_wrenches(matrix_of_jet_axis, jet_intensities)\ndim_wrench "
      "= 6;\nnum_jets = 4;\n\n% the jets produce pure force (no momentum)\n% the wrench is a 6dim vector [Fx, Fy, Fz, 0"
      ", 0, 0].transpose\n\nwrenches_vector = zeros(dim_wrench*num_jets, 1);\nfor i=0:(num_jets-1)\n    wrenches_vector"
      "(dim_wrench*i + 1: dim_wrench*i + dim_wrench/2) = matrix_of_jet_axis(:,i+1)*jet_intensities(i+1);\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
