    eml {
      isEML		      1
      script		      "function [Hessian, gradient, ConstraintMatrix_inequality, biasVectorConstraint_inequality, jointV"
      "el_err] =  ... \n             flyingTorqueControlFCN(M, h, J_jets, J_LFoot, J_RFoot, JDot_LFoot_nu, JDot_RFoot_n"
      "u, w_H_LFoot, w_H_RFoot, matrixOfJetsAxes, ...\n                                    ConstraintsMatrix_feet, bias"
      "VectorConstraint_feet, jetsIntensities, stateVel, jointVel_star, contactForces_star, ...\n                      "
      "              KI_torqueControl, KP_torqueControl, feetContactIsActive, activateEqConstrTorqueControl, robotIsLan"
      "ded, jointPos_err, Config)\n                                      \n    [Hessian, gradient, ConstraintMatrix_ine"
      "quality, biasVectorConstraint_inequality, jointVel_err] =  ... \n        flyingTorqueControl(M, h, J_jets, J_LFo"
