    eml {
      isEML		      1
      script		      "function [jetDerivativesOut, jetAccelerationOut] = fcn(u, jetIntensities, jetDerivatives, Config)"
      "\njetDerivativesOut = zeros(4,1);\njetAccelerationOut = zeros(4,1);\nfor i=1:4\n    state = [jetIntensities(i), "
      "jetDerivatives(i)];\n    x = jetModel.get_xDot(state, Config.jet.coeff(i,:), u(i));\n    jetDerivativesOut(i) = "
      "x(1);\n    jetAccelerationOut(i) = x(2);\nend\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
