          <Prompt>This block implements the momentum-based flight controller decribed in RAL 2018 and HUMANOIDS 2018 papers. </Prompt>
        </DialogControl>
        <DialogControl Type="Text" Name="Control3">
          <Prompt>References:</Prompt>
        </DialogControl>
        <DialogControl Type="Hyperlink" Name="Control5">
