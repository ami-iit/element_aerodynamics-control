      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [decreaseMaxFootVerticalForce, increaseMinFootVerticalForce, activateEqConstrTorqueControl] = verticalForcesControlFCN(joyButtons)

    [decreaseMaxFootVerticalForce, increaseMinFootVerticalForce, activateEqConstrTorqueControl] = iRonCubLib.verticalForcesControl(joyButtons);
end
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
