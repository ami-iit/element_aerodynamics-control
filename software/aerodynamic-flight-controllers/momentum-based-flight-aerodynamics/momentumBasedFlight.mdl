  }
  state {
    id			    329
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    328
    treeNode		    [328 0 0 0]
    superState		    SUBCHART
    subviewer		    328
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [b_omega_b, RDot] = rotationDerivativeFromAngVelFCN(gainSmoothingBaseRot, w_R_b_des, w_R"
      "_b)\n                                                                                                           "
      "                                                 \n    % Rotational PID: \n    %\n    % w_R_b_des = reference ro"
      "tation (may be discontinuous)\n    % \n    % b_omega_b = control input for the rotational PID. The angular veloc"
      "ity\n    %             is expressed w.r.t. a frame attached to the link, i.e. it \n    %             is expresse"
      "d in the \"body\" frame (b).\n    % \n    % Kp        = control gain\n    %\n    % w_R_b     = smooth base rotat"
      "ion\n    %\n    b_omega_b_des       = zeros(3,1);\n    Kp                  = gainSmoothingBaseRot;\n    b_omega_"
      "b           = wbc.rotationalPID_bodyVelocity(w_R_b, w_R_b_des, b_omega_b_des, Kp);\n                      \n    "
      "% compute the rotation matrix derivative given the angular velocity in body frame\n    RDot                = wbc"
      ".rotationDerivativeFromBodyAngVel(b_omega_b, w_R_b); \nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
