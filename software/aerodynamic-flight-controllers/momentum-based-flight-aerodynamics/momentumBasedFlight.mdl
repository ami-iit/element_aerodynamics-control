<?xml version="1.0" encoding="utf-8"?>
<chart id="267">
  <P Name="name">FLIGHT CONTROLLER (CORE) V2.5 - AERO/Flight State Machine/Compute Gains And References/Trajectory Generator/Detect Robot Movement Request From Joystick</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">267</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">17</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">detectMovementsFromJoystickFCN</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">267</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [moveFront,moveLateral,moveUpDown,rotateRoll,rotatePitch,rotateYaw,turbo_mode,goLandingPos] = detectMovementsFromJoystickFCN(joyAxes,joyButtons)

    [moveFront,moveLateral,moveUpDown,rotateRoll,rotatePitch,rotateYaw,turbo_mode,goLandingPos] = iRonCubLib.detectMovementsFromJoystick(joyAxes,joyButtons);
end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="joyAxes">
      <P Name="scope">INPUT_DATA</P>
