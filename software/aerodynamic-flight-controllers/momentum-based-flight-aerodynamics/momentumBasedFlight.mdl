<?xml version="1.0" encoding="utf-8"?>
<chart id="335">
  <P Name="name">FLIGHT CONTROLLER (CORE) V2.5 - AERO/Flight State Machine/Take Off//Landing State Detector/Vertical Forces Control</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
