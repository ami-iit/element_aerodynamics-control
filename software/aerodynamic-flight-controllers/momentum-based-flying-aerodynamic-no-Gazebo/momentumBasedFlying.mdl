    name		    "FLYING CONTROLLER (CORE) V2.5/Flying State Machine/Compute Gains And References/Smooth CoM and Base Ref"
    "erences/Smooth Reference Orientations/Rotational PID Controller/Compute Rotation Matrix Derivative"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 361 0 0]
    viewObj		    360
    ssIdHighWaterMark	    32
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    43
    disableImplicitCasting  1
    eml {
      name		      "rotationDerivativeFromAngVelFCN"
    }
    firstData		    362
    firstTransition	    368
    firstJunction	    367
  }
  state {
    id			    361
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    360
    treeNode		    [360 0 0 0]
    superState		    SUBCHART
    subviewer		    360
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [b_omega_b, RDot] = rotationDerivativeFromAngVelFCN(gainSmoothingBaseRot, w_R_b_des, w_R"
      "_b)\n                                                                                                           "
      "                                                 \n    % Rotational PID: \n    %\n    % w_R_b_des = reference ro"
      "tation (may be discontinuous)\n    % \n    % b_omega_b = control input for the rotational PID. The angular veloc"
      "ity\n    %             is expressed w.r.t. a frame attached to the link, i.e. it \n    %             is expresse"
      "d in the \"body\" frame (b).\n    % \n    % Kp        = control gain\n    %\n    % w_R_b     = smooth base rotat"
      "ion\n    %\n    b_omega_b_des       = zeros(3,1);\n    Kp                  = gainSmoothingBaseRot;\n    b_omega_"
      "b           = rotationalPID_bodyVelocity(w_R_b, w_R_b_des, b_omega_b_des, Kp);\n                      \n    % co"
      "mpute the rotation matrix derivative given the angular velocity in body frame\n    RDot                = rotatio"
      "nDerivativeFromBodyAngVel(b_omega_b, w_R_b); \nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
