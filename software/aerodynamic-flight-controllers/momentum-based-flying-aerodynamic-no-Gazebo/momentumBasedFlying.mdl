    firstTransition	    266
    firstJunction	    265
  }
  state {
    id			    260
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    259
    treeNode		    [259 0 0 0]
    superState		    SUBCHART
    subviewer		    259
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function KP_linear_t = gain_scheduling(KP_linear,KP2_linear,t)\n% a=15/4;\n% b=-15;\n% c=15;\n% i"
      "f 5<=t && t<7\n%     KP_linear_t=KP_linear+a*(t-5+(-b/2/a))^2+b*(t-5+(-b/2/a))+c;\n% \n% else\n%     KP_linear_t"
      "=KP_linear;\n% end\n\nif 6<=t && t<=8\n    KP_linear_t=KP2_linear;\nelse\n    KP_linear_t=KP_linear;\nend\n\n\n\n"
      "\nend\n\n% elseif 8<=t && t<=10\n%     KP_linear_t=KP_linear+a*(t-8)^2+b*(t-8)+c;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
