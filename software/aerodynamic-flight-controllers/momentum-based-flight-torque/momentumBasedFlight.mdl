  <P Name="chartFileNumber">13</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">flyingMomentumControlFCN</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">196</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [HessianMatrixQP, gVectorQP, lowerBoundQP, upperBoundQP, L_des, LDot_estimated, verifyAngMomAndInertia, velCoM] = ...
             flyingMomentumControlFCN(jointPos, w_baseTwist, jetsIntensities, J_jets, J_CoM, J_LFoot, J_RFoot, posCoM, w_R_b, w_H_LFoot, ...
                                      w_H_RFoot, matrixOfJetsAxes, matrixOfJetsArms, w_I_c, L, M, CMM, pos_vel_acc_jerk_CoM_des, ....
                                      rot_vel_acc_jerk_base_des, jointPos_des, KP_momentum, KD_momentum, KP_postural, feetContactIsActive, ...
                                      decreaseMaxFootVerticalForce, increaseMinFootVerticalForce, robotIsLanded, contactForces_hat, Config)
                               
    [HessianMatrixQP, gVectorQP, lowerBoundQP, upperBoundQP, L_des, LDot_estimated, verifyAngMomAndInertia, velCoM] = ...
        flyingMomentumControl(jointPos, w_baseTwist, jetsIntensities, J_jets, J_CoM, J_LFoot, J_RFoot, posCoM, w_R_b, w_H_LFoot, ...
                                         w_H_RFoot, matrixOfJetsAxes, matrixOfJetsArms, w_I_c, L, M, CMM, pos_vel_acc_jerk_CoM_des, ....
