<chart id="196">
  <P Name="name">FLIGHT CONTROLLER (CORE) V3.0/Flight Controller RAL-HUMANOIDS V3.0/Momentum Control for Flying/Momentum Control/Flying Controller Momentum FCN </P>
  <P Name="windowPosition">[407.733 70.167 186 702]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 2966 1200 1.25]</P>
  <P Name="viewObj">196</P>
