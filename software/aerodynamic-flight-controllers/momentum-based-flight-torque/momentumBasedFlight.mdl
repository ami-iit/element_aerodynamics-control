    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [HessianMatrixQP, gVectorQP, lowerBoundQP, upperBoundQP, L_des, LDot_estimated, verifyAn"
      "gMomAndInertia, velCoM] = ...\n             aeroFlyingMomentumControlFCN(jointPos, w_baseTwist, jetsIntensities,"
      " J_jets, J_CoM, J_LFoot, J_RFoot, posCoM, w_R_b, w_H_LFoot, w_H_RFoot, ...\n                                    "
      "      matrixOfJetsAxes, matrixOfJetsArms, matrixOfAeroArms, J_aeroForces, w_I_c, L, M, CMM, pos_vel_acc_jerk_CoM"
      "_des, ....\n                                          rot_vel_acc_jerk_base_des, jointPos_des, KP_momentum, KD_m"
      "omentum, KP_postural, feetContactIsActive, ...\n                                          decreaseMaxFootVertica"
      "lForce, increaseMinFootVerticalForce, robotIsLanded, contactForces_hat, aerodynamic_forces, Config, aero_config)"
      "\n                               \n    [HessianMatrixQP, gVectorQP, lowerBoundQP, upperBoundQP, L_des, LDot_esti"
      "mated, verifyAngMomAndInertia, velCoM] = ...\n        aeroFlyingMomentumControl(jointPos, w_baseTwist, jetsInten"
      "sities, J_jets, J_CoM, J_LFoot, J_RFoot, posCoM, w_R_b, w_H_LFoot, w_H_RFoot, ...\n                             "
      "     matrixOfJetsAxes, matrixOfJetsArms, matrixOfAeroArms, J_aeroForces, w_I_c, L, M, CMM, pos_vel_acc_jerk_CoM_"
      "des, ....\n                                  rot_vel_acc_jerk_base_des, jointPos_des, KP_momentum, KD_momentum, "
      "KP_postural, feetContactIsActive, ...\n                                  decreaseMaxFootVerticalForce, increaseM"
      "inFootVerticalForce, robotIsLanded, contactForces_hat, aerodynamic_forces, aero_config, Config);\nend"
    }
  }
