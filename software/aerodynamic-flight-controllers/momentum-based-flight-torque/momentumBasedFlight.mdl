<chart id="324">
  <P Name="name">FLIGHT CONTROLLER (CORE) V3.0/UpdateGuiData/Update Data for the GUI</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">324</P>
  <P Name="ssIdHighWaterMark">5</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">22</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">updateVisualGuiFCN</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">324</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function updateVisualGuiFCN(time)

    coder.extrinsic(&apos;updateVisualGui&apos;)

    persistent updateTime

    % for now I hard-coded 0.25 [s] as updating time for the data GUI
    timeStepGui    = 0.25;

    if isempty(updateTime)
    
        updateTime = timeStepGui;
    end
    
    % update data GUI
    if time &gt; updateTime
    
        updateVisualGui;
        updateTime = time + timeStepGui;  
    end
end
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
