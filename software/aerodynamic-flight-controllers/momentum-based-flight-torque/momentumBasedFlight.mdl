  <eml>
    <P Name="name">invHomMatrix</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">95</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function l_sole_H_b = invHomMatrix(b_H_l_sole)

    l_sole_H_b = [b_H_l_sole(1:3, 1:3)&apos;, -b_H_l_sole(1:3, 1:3)&apos; * b_H_l_sole(1:3, 4); ...
                   zeros(1,3),              1];
end</P>
        <P Name="vectorOutputs1D">1</P>
