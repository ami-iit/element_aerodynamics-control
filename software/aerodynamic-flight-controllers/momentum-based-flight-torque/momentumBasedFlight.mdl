<?xml version="1.0" encoding="utf-8"?>
<ModelInformation Version="1.0">
  <Model>
    <P Name="ModelUUID">2b1072b3-3949-49b8-81d5-3dfae10e30bc</P>
    <P Name="InitFcn">cd(fileparts(which(bdroot)));
initMomentumBasedFlight;</P>
    <P Name="StopFcn">cd(fileparts(which(bdroot)));
stopMomentumBasedFlight;</P>
    <P Name="LastSavedArchitecture">glnxa64</P>
    <ConfigManagerSettings>
      <P Name="ModifiedByFormat">%&lt;Auto&gt;</P>
      <P Name="ModifiedDateFormat">%&lt;Auto&gt;</P>
      <P Name="RTWModifiedTimeStamp">610029146</P>
      <P Name="ModelVersionFormat">%&lt;AutoIncrement:4.19&gt;</P>
    </ConfigManagerSettings>
    <EditorSettings>
      <P Name="ShowLineDimensions">on</P>
      <P Name="BrowserShowLibraryLinks">on</P>
      <P Name="BrowserLookUnderMasks">on</P>
      <P Name="MultithreadedSim">on</P>
    </EditorSettings>
    <SimulationSettings>
      <P Name="SimulationMode">normal</P>
      <P Name="NumberOfSteps">50</P>
      <Object PropName="DataLoggingOverride" ObjectID="1" ClassName="Simulink.SimulationData.ModelLoggingInfo">
        <P Name="model_" Class="char">$bdroot</P>
        <P Name="overrideMode_" Class="double">0.0</P>
        <Array PropName="logAsSpecifiedByModels_" Type="Cell" Dimension="1*1">
          <Cell Class="char">$bdroot</Cell>
        </Array>
        <Array PropName="logAsSpecifiedByModelsSSIDs_" Type="Cell" Dimension="1*1">
          <Cell Class="double">[]</Cell>
        </Array>
      </Object>
    </SimulationSettings>
    <EngineSettings>
      <P Name="ConfigurableSubsystemUsage">warning</P>
    </EngineSettings>
    <ConcurrentExecutionSettings>
      <Object PropName="DataTransfer" ObjectID="2" ClassName="Simulink.GlobalDataTransfer">
        <P Name="DefaultTransitionBetweenSyncTasks" Class="char">Ensure deterministic transfer (maximum delay)</P>
        <P Name="DefaultTransitionBetweenAsyncTasks" Class="char">Ensure data integrity only</P>
        <P Name="DefaultTransitionBetweenContTasks" Class="char">Ensure deterministic transfer (minimum delay)</P>
        <P Name="DefaultExtrapolationMethodBetweenContTasks" Class="char">None</P>
      </Object>
    </ConcurrentExecutionSettings>
    <System Ref="system_root"/>
