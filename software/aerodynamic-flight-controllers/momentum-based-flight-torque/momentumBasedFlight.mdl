<chart id="267">
  <P Name="name">FLIGHT CONTROLLER (CORE) V3.0/Flight Controller RAL-HUMANOIDS V3.0/Joint Torque Control for Flying/torqueControlFCN</P>
  <P Name="windowPosition">[407.733 70.167 186 702]</P>
