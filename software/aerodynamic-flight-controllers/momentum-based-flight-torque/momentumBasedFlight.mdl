      <P Name="subviewer">246</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function imu_H_b = invHomMatrix(b_H_imu)

    imu_H_b = [b_H_imu(1:3, 1:3)&apos;, -b_H_imu(1:3, 1:3)&apos; * b_H_imu(1:3, 4); ...
                   zeros(1,3),              1];
