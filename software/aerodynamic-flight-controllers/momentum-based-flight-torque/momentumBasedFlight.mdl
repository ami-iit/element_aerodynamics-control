  <eml>
    <P Name="name">flyingTorqueControlFCN</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">267</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [Hessian, gradient, ConstraintMatrix_inequality, biasVectorConstraint_inequality, jointVel_err] =  ... 
             flyingTorqueControlFCN(M, h, J_jets, J_LFoot, J_RFoot, JDot_LFoot_nu, JDot_RFoot_nu, w_H_LFoot, w_H_RFoot, matrixOfJetsAxes, ...
                                    ConstraintsMatrix_feet, biasVectorConstraint_feet, jetsIntensities, stateVel, jointVel_star, contactForces_star, ...
                                    KI_torqueControl, KP_torqueControl, feetContactIsActive, activateEqConstrTorqueControl, robotIsLanded, jointPos_err, Config)
                                      
    [Hessian, gradient, ConstraintMatrix_inequality, biasVectorConstraint_inequality, jointVel_err] =  ... 
            flyingTorqueControl(M, h, J_jets, J_LFoot, J_RFoot, JDot_LFoot_nu, JDot_RFoot_nu, w_H_LFoot, w_H_RFoot, matrixOfJetsAxes, ...
                                       ConstraintsMatrix_feet, biasVectorConstraint_feet, jetsIntensities, stateVel, jointVel_star, contactForces_star, ...
                                       KI_torqueControl, KP_torqueControl, feetContactIsActive, activateEqConstrTorqueControl, robotIsLanded, jointPos_err, Config);           
end</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="37" name="M">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
