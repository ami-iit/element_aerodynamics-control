  chart {
    id			    290
    machine		    1
    name		    "FLIGHT CONTROLLER (CORE) V3.0/generate wind profile/MATLAB Function"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 291 0 0]
    viewObj		    290
    ssIdHighWaterMark	    6
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    30
    disableImplicitCasting  1
    eml {
      name		      "generatewindSpeed"
    }
    firstData		    292
    firstTransition	    296
    firstJunction	    295
  }
  state {
    id			    291
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    290
    treeNode		    [290 0 0 0]
    superState		    SUBCHART
    subviewer		    290
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function windSpeed = generatewindSpeed(maxWindSpeed, time)\n    \n    time_windStart = 5;\n    ti"
      "me_maxWind   = 10;\n    \n    if time <= time_windStart\n        windSpeed = zeros(3,1);\n    else \n        if "
      "(time > time_windStart && time <= time_maxWind)\n            windSpeed = maxWindSpeed * (time - time_windStart)/"
      "(time_maxWind - time_windStart);\n        else\n            windSpeed = maxWindSpeed;\n        end\n    end\n\ne"
      "nd"
    }
  }
